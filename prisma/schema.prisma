// FindIt data model
// This schema documents ownership requirements from the PRD.
// The frontend currently persists ads client-side (localStorage via src/lib/adStore.ts);
// swap in a Prisma client + database when the backend is implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  ads       Ad[]
}

model Ad {
  id            String     @id @default(cuid())
  userId        String
  title         String
  description   String
  price         Float?
  currency      String     @default("INR")
  condition     String?
  images        String     // JSON-encoded array of image URLs / base64 previews
  contactEmail  String
  addressText   String?
  countryIso    String?
  stateIso      String?
  city          String?
  postalCode    String?
  categorySlug  String
  subcategorySlug String?
  status        String     @default("Active") // Active | Pending Review | Sold | Archived
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}